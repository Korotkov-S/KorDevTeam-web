# Copy to /etc/kordevteam/operations.env, set mode 0600 and replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/kordev
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=kordev

ADMIN_SESSION_HMAC_KEY=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
ADMIN_RATE_LIMIT_HMAC_KEY=REPLACE_WITH_DIFFERENT_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
ADMIN_TRUSTED_ORIGIN=https://kordev.team

PUBLIC_MEDIA_S3_ENDPOINT=https://s3.twcstorage.ru
PUBLIC_MEDIA_S3_REGION=ru-1
PUBLIC_MEDIA_S3_BUCKET=REPLACE_ME
PUBLIC_MEDIA_S3_ACCESS_KEY_ID=REPLACE_ME
PUBLIC_MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_ME
PUBLIC_MEDIA_S3_PREFIX=media
PUBLIC_MEDIA_BASE_URL=https://REPLACE_ME/
PUBLIC_MEDIA_S3_SSE=AES256

# First-party SEO collection. Keep each source disabled until its read-only credentials pass --check.
SEO_YANDEX_ENABLED=false
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_HOST_ID=

SEO_GOOGLE_ENABLED=false
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# Canonical base64 of the service-account RSA PKCS8 PEM, without line breaks.
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY_B64=

# Existing lead intake, worker, SMTP, backup and release variables remain required.
