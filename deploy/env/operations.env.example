# Copy to /etc/kordevteam/operations.env, set mode 0600 and replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/kordev
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=kordev

ADMIN_SESSION_HMAC_KEY=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
ADMIN_RATE_LIMIT_HMAC_KEY=REPLACE_WITH_DIFFERENT_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
ADMIN_TRUSTED_ORIGIN=https://kordev.team

PUBLIC_MEDIA_S3_ENDPOINT=https://s3.twcstorage.ru
PUBLIC_MEDIA_S3_REGION=ru-1
PUBLIC_MEDIA_S3_BUCKET=REPLACE_ME
PUBLIC_MEDIA_S3_ACCESS_KEY_ID=REPLACE_ME
PUBLIC_MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_ME
PUBLIC_MEDIA_S3_PREFIX=media
PUBLIC_MEDIA_BASE_URL=https://REPLACE_ME/
# Timeweb rejects the AWS SSE-S3 request header; use provider-managed storage.
# Use AES256 only with an S3 implementation that accepts SSE-S3.
PUBLIC_MEDIA_S3_SSE=provider

# First-party SEO collection. Keep each source disabled until its read-only credentials pass --check.
SEO_YANDEX_ENABLED=false
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_HOST_ID=

SEO_GOOGLE_ENABLED=false
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# Canonical base64 of the service-account RSA PKCS8 PEM, without line breaks.
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY_B64=

# Official Yandex Metrica Reporting API. OAuth token needs read access to the counter.
SEO_YANDEX_METRIKA_ENABLED=false
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_COUNTER_ID=

# Official Yandex Search API control ranks. The API key needs yc.search-api.execute scope.
SEO_YANDEX_SEARCH_ENABLED=false
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
# Maximum checks per weekly query-region-device run: integer 16..100000, default 1000.
# The variable name is retained for backward compatibility.
SEO_YANDEX_SEARCH_DAILY_LIMIT=1000
SEO_TARGET_HOST=kordev.team

# Exact public HTTPS origin used only by the isolated GEO crawler-health check.
# Do not add a path, query, credentials or browser cookies.
GEO_SITE_ORIGIN=https://kordev.team

# Read-only VK Ads mirror. Deploy migrations with sync disabled first.
# The old client secret previously disclosed in chat is compromised: never reuse it; issue a new one before enabling.
VK_ADS_SYNC_ENABLED=false
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=
# Canonical base64 of exactly 32 new random bytes. Keep outside backups.
VK_ADS_TOKEN_ENCRYPTION_KEY_B64=
VK_ADS_S3_ENDPOINT=https://s3.twcstorage.ru
VK_ADS_S3_REGION=ru-1
VK_ADS_S3_BUCKET=REPLACE_ME_PRIVATE_BUCKET
# Separate IAM credentials: web gets GetObject only; the scheduled job gets List/Get/Put for ads/vk/creatives/.
VK_ADS_S3_READ_ACCESS_KEY_ID=REPLACE_ME_READ_ONLY
VK_ADS_S3_READ_SECRET_ACCESS_KEY=REPLACE_ME_READ_ONLY
VK_ADS_S3_WRITE_ACCESS_KEY_ID=REPLACE_ME_WRITE
VK_ADS_S3_WRITE_SECRET_ACCESS_KEY=REPLACE_ME_WRITE
# Timeweb provider-managed encryption; use AES256 only when the S3 implementation accepts that header.
VK_ADS_S3_SSE=provider

# Existing lead intake, worker, SMTP, backup and release variables remain required.
