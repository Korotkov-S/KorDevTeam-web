[Unit]
Description=Resume existing KorDevTeam rank operations without creating a plan
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/kordevteam/current
EnvironmentFile=/etc/kordevteam/operations.env
ExecStart=/bin/bash /opt/kordevteam/current/scripts/run-seo-rank-recover.sh
UMask=0077
NoNewPrivileges=true
