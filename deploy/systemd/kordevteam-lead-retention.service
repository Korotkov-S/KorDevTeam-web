[Unit]
Description=Delete expired KorDevTeam lead copies
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=kordevteam
WorkingDirectory=/opt/kordevteam/current
EnvironmentFile=/etc/kordevteam/operations.env
ExecStart=/bin/bash /opt/kordevteam/current/scripts/run-lead-retention.sh
UMask=0077
NoNewPrivileges=true
