# Порт для API сервера
PORT=3001

# Единственная production-учётная запись администратора. Встроенных значений нет.
ADMIN_USER=replace-with-admin-login
ADMIN_PASSWORD=replace-with-a-long-random-password
# Bearer-токен для автоматизированного доступа к тем же защищённым маршрутам.
# Для генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-random-token

# Окружение (development, production)
NODE_ENV=development

# --- SQLite ---
# Path to sqlite database file (absolute or relative to repo root)
SQLITE_PATH=server/data/runtime.sqlite

# --- Upload limits ---
UPLOAD_MAX_BYTES=10485760

# --- S3 uploads (optional but recommended) ---
# If S3_BUCKET is set, /api/admin/upload-*-image will upload to S3 and return a public URL.
S3_BUCKET=your-bucket-name
S3_REGION=eu-central-1
# Recommended: public base URL for your bucket (CloudFront or public bucket URL)
S3_PUBLIC_BASE_URL=https://cdn.example.com

# For S3-compatible (MinIO etc), set endpoint and (optionally) path style.
# S3_ENDPOINT=https://s3.your-provider.com
# S3_FORCE_PATH_STYLE=1

# Credentials (for S3-compatible providers like Timeweb.Cloud)
# You can also use standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: if your bucket expects ACL on upload (many setups instead use bucket policy)
# S3_ACL=public-read

# --- Заявки с сайта: серверная конфигурация ---
# Версию нужно менять при публикации новой редакции согласия/политики.
LEAD_CONSENT_VERSION=2026-09-14
# Не менее 32 случайных байт в canonical base64.
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LEAD_HASH_KEY=replace-with-a-canonical-base64-key
LEAD_TEMP_ROOT=/tmp/kordev-leads

# Отдельный приватный бакет заявок. Не используйте здесь публичные S3_* credentials выше.
LEAD_S3_ENDPOINT=https://s3.twcstorage.ru
LEAD_S3_REGION=ru-1
LEAD_S3_BUCKET=replace-with-private-leads-bucket
LEAD_S3_ACCESS_KEY_ID=replace-with-private-access-key
LEAD_S3_SECRET_ACCESS_KEY=replace-with-private-secret-key
LEAD_S3_PREFIX=leads/
LEAD_S3_SSE=AES256

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Только worker: Krasotula CRM и резервная доставка по SMTP.
CRM_INTAKE_ENDPOINT=https://crm.example.invalid/api/v1/board-intake/replace-public-id/requests
CRM_INTAKE_TOKEN=replace-with-board-token
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=team@korotkov.dev
LEAD_EMAIL_TO=team@korotkov.dev

# Только production Compose: неизменяемые ссылки на образы.
WORKER_IMAGE=ghcr.io/owner/repository@sha256:replace-with-64-hex-digest
CLAMAV_IMAGE=clamav/clamav@sha256:replace-with-64-hex-digest
